@page "/deck-import"
@rendermode InteractiveServer

@using System.Security.Claims
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using FoxMield.Components.Models
@using FoxMield.Components.Services

@inject DeckService DeckService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Import Deck | FoxMield</PageTitle>

<div class="deck-import-page">

    <div class="deck-page-heading">
        <h1>Import a Commander Deck</h1>
        <p>
            Import your Commander deck using Plain Text,
            CSV, or JSON. Paste a decklist or upload a file.
        </p>
    </div>

    <div class="deck-form-panel">

        <div class="deck-field">
            <label for="deck-name">Deck Name</label>

            <input id="deck-name"
                   type="text"
                   maxlength="120"
                   placeholder="Enter your deck name"
                   @bind="deckName" />

            <p class="deck-hint">
                JSON imports can automatically provide the deck name.
            </p>
        </div>

        <div class="deck-field">

            <label>Upload a Deck File</label>

            <InputFile OnChange="HandleFileUpload"
                       accept=".txt,.csv,.json"
                       class="deck-file-input" />

            <p class="deck-hint">
                Supported formats: .txt, .csv, and .json.
                Maximum file size: 1 MB.
            </p>

            @if (!string.IsNullOrWhiteSpace(uploadedFileName))
            {
                <p class="deck-upload-success">
                    Selected file: @uploadedFileName
                </p>
            }

        </div>

        <div class="deck-import-divider">
            <span>OR</span>
        </div>

        <div class="deck-field">

            <label for="deck-list">Paste a Decklist</label>

            <textarea id="deck-list"
                      rows="16"
                      spellcheck="false"
                      placeholder="Commander&#10;1 Atraxa, Praetors' Voice&#10;&#10;Deck&#10;1 Sol Ring&#10;1 Arcane Signet"
                      @bind="deckText"
                      @bind:event="oninput"
                      @bind:after="ResetPreview"></textarea>

            <p class="deck-hint">
                Paste Plain Text, CSV, or JSON.
                FoxMield will automatically detect the format.
            </p>

        </div>

        <button type="button"
                class="deck-secondary-button"
                disabled="@isImporting"
                @onclick="PreviewDeck">
            Preview Cards
        </button>

        @if (previewCards.Count > 0)
        {
            <div class="deck-preview">

                <div class="deck-preview-heading">
                    <h2>Deck Preview</h2>

                    <span class="deck-format-badge">
                        @detectedFormat
                    </span>
                </div>

                <p>
                    @previewCards.Count distinct card entries found.
                </p>

                <p>
                    @previewCards.Sum(c => c.Quantity)
                    total cards across all sections.
                </p>

                <p>
                    @PreviewDeckCount / 100 Commander deck cards.
                </p>

                <div class="deck-preview-sections">

                    @foreach (var group in previewCards
                        .GroupBy(c => c.Section)
                        .OrderBy(g => GetSectionOrder(g.Key)))
                    {
                        <div class="deck-preview-section-row">

                            <span>@group.Key</span>

                            <strong>
                                @group.Sum(c => c.Quantity)
                            </strong>

                        </div>
                    }

                </div>

                @if (HasCommander)
                {
                    <div class="commander-preview">

                        <h3>Commander</h3>

                        @foreach (var commander in previewCards
                            .Where(c => c.Section == "Commander"))
                        {
                            <p>
                                @commander.Quantity x @commander.Name
                            </p>
                        }

                    </div>
                }
                else
                {
                    <div class="commander-selection">

                        <h3>Select Your Commander</h3>

                        <p>
                            Your imported deck did not identify a commander.
                            Select one from the imported main deck cards.
                        </p>

                        <div class="deck-field">

                            <label for="commander-one">
                                Primary Commander
                            </label>

                            <select id="commander-one"
                                    @bind="selectedCommander">

                                <option value="">
                                    Select Commander
                                </option>

                                @foreach (var card in CommanderOptions)
                                {
                                    <option value="@card.Name">
                                        @card.Name
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="deck-field">

                            <label for="commander-two">
                                Second Commander (Optional)
                            </label>

                            <select id="commander-two"
                                    @bind="secondCommander">

                                <option value="">
                                    None
                                </option>

                                @foreach (var card in CommanderOptions)
                                {
                                    <option value="@card.Name">
                                        @card.Name
                                    </option>
                                }

                            </select>

                        </div>

                        <p class="deck-hint">
                            Only select a second commander if your deck
                            legally supports multiple commanders.
                        </p>

                    </div>
                }

            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="deck-error" role="alert">
                @errorMessage
            </p>
        }

        <div class="deck-form-actions">

            <button type="button"
                    class="deck-primary-button"
                    disabled="@(isImporting || previewCards.Count == 0)"
                    @onclick="ImportDeck">

                @(isImporting ? "Importing..." : "Import Deck")

            </button>

            <a href="/decks"
               class="deck-secondary-button">
                View My Decks
            </a>

        </div>

    </div>

</div>

@code {

    private const long MaximumFileSize = 1024 * 1024;

    private string deckName = "";
    private string deckText = "";

    private string selectedCommander = "";
    private string secondCommander = "";

    private string? errorMessage;
    private string? previewSource;
    private string? uploadedFileName;
    private string? detectedFormat;

    private bool isImporting = false;

    private List<DeckEntry> previewCards = new();

    private bool HasCommander =>
        previewCards.Any(c => c.Section == "Commander");

    private int PreviewDeckCount =>
        previewCards
            .Where(c =>
                c.Section == "Commander" ||
                c.Section == "Main Deck")
            .Sum(c => c.Quantity);

    private List<DeckEntry> CommanderOptions =>
        previewCards
            .Where(c => c.Section == "Main Deck")
            .OrderBy(c => c.Name)
            .ToList();

    private void ResetPreview()
    {
        previewCards.Clear();

        selectedCommander = "";
        secondCommander = "";

        previewSource = null;
        detectedFormat = null;
        errorMessage = null;
    }

    private async Task HandleFileUpload(
        InputFileChangeEventArgs e)
    {
        ResetPreview();
        uploadedFileName = null;

        IBrowserFile file = e.File;

        string extension = Path.GetExtension(file.Name)
            .ToLowerInvariant();

        if (extension != ".txt" &&
            extension != ".csv" &&
            extension != ".json")
        {
            errorMessage =
                "Only TXT, CSV, and JSON files are supported.";
            return;
        }

        if (file.Size > MaximumFileSize)
        {
            errorMessage =
                "The selected file is too large. Maximum size is 1 MB.";
            return;
        }

        try
        {
            using Stream stream =
                file.OpenReadStream(MaximumFileSize);

            using StreamReader reader = new(
                stream,
                Encoding.UTF8,
                detectEncodingFromByteOrderMarks: true);

            deckText = await reader.ReadToEndAsync();

            uploadedFileName = file.Name;

            PreviewDeck();
        }
        catch (IOException)
        {
            errorMessage =
                "Unable to read the uploaded file.";
        }
        catch (Exception)
        {
            errorMessage =
                "An error occurred while uploading the file.";
        }
    }

    private void PreviewDeck()
    {
        ResetPreview();

        try
        {
            DeckImportResult result =
                DeckImportParser.Parse(deckText);

            previewCards = result.Cards;
            detectedFormat = result.Format;
            previewSource = deckText;

            if (!string.IsNullOrWhiteSpace(result.DeckName))
            {
                deckName = result.DeckName.Trim();
            }
        }
        catch (FormatException ex)
        {
            errorMessage = ex.Message;
        }
        catch (OverflowException)
        {
            errorMessage =
                "A card quantity in the imported deck is too large.";
        }
    }

    private async Task ImportDeck()
    {
        if (isImporting)
            return;

        errorMessage = null;

        if (string.IsNullOrWhiteSpace(deckName))
        {
            errorMessage = "Please enter a deck name.";
            return;
        }

        if (deckName.Trim().Length > 120)
        {
            errorMessage =
                "Deck names cannot exceed 120 characters.";
            return;
        }

        if (previewSource == null ||
            previewSource != deckText)
        {
            errorMessage =
                "Please preview your current decklist before importing.";
            return;
        }

        isImporting = true;

        try
        {
            DeckImportResult result =
                DeckImportParser.Parse(deckText);

            List<DeckEntry> cards = result.Cards;

            bool hasCommander = cards.Any(c =>
                c.Section == "Commander");

            if (!hasCommander)
            {
                if (string.IsNullOrWhiteSpace(selectedCommander))
                {
                    throw new FormatException(
                        "Please select your commander.");
                }

                if (selectedCommander.Equals(
                    secondCommander,
                    StringComparison.OrdinalIgnoreCase))
                {
                    throw new FormatException(
                        "The two commanders must be different cards.");
                }

                PromoteCommander(cards, selectedCommander);

                if (!string.IsNullOrWhiteSpace(secondCommander))
                {
                    PromoteCommander(cards, secondCommander);
                }
            }

            string textToImport = BuildDeckText(cards);

            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            string? userId = authState.User
                .FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(userId))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            Deck importedDeck = await DeckService.ImportDeckAsync(
                deckName.Trim(),
                textToImport,
                userId
            );

            Navigation.NavigateTo(
                $"/decks/{importedDeck.Id}"
            );
        }
        catch (FormatException ex)
        {
            errorMessage = ex.Message;
        }
        catch (OverflowException)
        {
            errorMessage =
                "A card quantity in the imported deck is too large.";
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage =
                "You must be logged in to import a deck.";
        }
        catch (Exception)
        {
            errorMessage =
                "Something went wrong while importing your deck.";
        }
        finally
        {
            isImporting = false;
        }
    }

    private static void PromoteCommander(
        List<DeckEntry> cards,
        string name)
    {
        DeckEntry? entry = cards.FirstOrDefault(c =>
            c.Section == "Main Deck" &&
            c.Name.Equals(
                name,
                StringComparison.OrdinalIgnoreCase));

        if (entry == null || entry.Quantity < 1)
        {
            throw new FormatException(
                $"Could not find commander: {name}");
        }

        entry.Quantity--;

        if (entry.Quantity == 0)
        {
            cards.Remove(entry);
        }

        cards.Add(new DeckEntry
        {
            Name = entry.Name,
            Quantity = 1,
            Section = "Commander"
        });
    }

    private static string BuildDeckText(
        List<DeckEntry> cards)
    {
        string[] sections =
        {
            "Commander",
            "Main Deck",
            "Sideboard",
            "Maybeboard",
            "Companion"
        };

        List<string> lines = new();

        foreach (string section in sections)
        {
            List<DeckEntry> sectionCards = cards
                .Where(c => c.Section == section)
                .ToList();

            if (sectionCards.Count == 0)
                continue;

            lines.Add(
                section == "Main Deck" ? "Deck" : section
            );

            foreach (DeckEntry card in sectionCards)
            {
                lines.Add($"{card.Quantity} {card.Name}");
            }

            lines.Add("");
        }

        return string.Join(
            Environment.NewLine,
            lines);
    }

    private static int GetSectionOrder(string section)
    {
        return section switch
        {
            "Commander" => 0,
            "Main Deck" => 1,
            "Sideboard" => 2,
            "Maybeboard" => 3,
            "Companion" => 4,
            _ => 5
        };
    }
}