@page "/"

<PageTitle>Home</PageTitle>

<div class="home-container">

    <header class="home-welcome">
        <h1>Welcome to FoxMield</h1>

        <p class="home-tagline">
            Build. Analyze. Refine.
        </p>

        <p class="home-description">
            Your companion for Magic: The Gathering deck building,
            management, and analysis. Explore your decks, discover
            their strengths and weaknesses, and refine your strategies.
        </p>
    </header>
    
    <div class="primary-cards">

        <a href="/DeckAnalysis" class="home-card deck-card">
            <h1>Deck Analyzer</h1>
            <p>
                Analyze your Magic: The Gathering decks with
                detailed statistics, mana curves, and color breakdowns.
            </p>
        </a>

        <a href="/decks" class="home-card deck-card">
            <h1>My Decks</h1>
            <p>
                Browse your imported Commander decks,
                view their cards, and explore your collection.
            </p>
        </a>

        <a href="/deck-create" class="home-card deck-card">
            <h1>Create Deck</h1>
            <p>
                Build a Commander deck from scratch.
            </p>
        </a>

    </div>

    <div class="secondary-cards">

        <div class="home-card small-card">
            <h2>Export</h2>
        </div>
        
        <a href="/deck-import" class="home-card small-card">
            <h2>Import</h2>
        </a>

    </div>

</div>