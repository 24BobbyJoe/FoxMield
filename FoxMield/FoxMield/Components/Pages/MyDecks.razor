@page "/decks"
@using FoxMield.Components.Models
@using FoxMield.Components.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject DeckService DeckService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>My Decks | FoxMield</PageTitle>

<div class="my-decks-page">

    <div class="decks-page-header">
        <div>
            <h1>My Decks</h1>
            <p>
                View and manage your imported
                Commander decks.
            </p>
        </div>
      
        <div class="decks-header-actions">

            <a href="/deck-export" class="decks-export-button">
                Export Deck
            </a>

            <a href="/deck-import" class="decks-import-button">
                + Import Deck
            </a>

        </div>
    </div>

    @if (decks.Count == 0)
    {
        <div class="decks-empty-state">
            <h2>No Decks Imported Yet</h2>
            <p>
                Your deck library is currently empty.
                Import a Commander deck from Moxfield
                to get started.
            </p>
            <a href="/deck-import" class="decks-import-button">
                Import Your First Deck
            </a>
        </div>
    }
    else
    {
        <div class="decks-summary">
            <h2>Your Collection</h2>
            <span>
                @decks.Count
                @(decks.Count == 1 ? "Deck" : "Decks")
            </span>
        </div>

        <div class="decks-list">
            @foreach (Deck deck in decks)
            {
                
                <div class="deck-list-card" @key="deck.Id">

                    <a href="@($"/decks/{deck.Id}")"
                       class="deck-card-view-link"
                       aria-label="@("View " + deck.Name)">
                    </a>

                    <div class="deck-list-main">
                        <h3>@deck.Name</h3>

                        <div class="deck-commander">
                            <span class="deck-label">
                                COMMANDER
                            </span>

                            @if (deck.CommanderCount > 0)
                            {
                                <p>
                                    @string.Join(", ",
                                        deck.Cards
                                            .Where(c =>
                                                c.Section == "Commander")
                                            .Select(c => c.Name))
                                </p>
                            }
                            else
                            {
                                <p>No commander assigned</p>
                            }
                        </div>
                    </div>

                    <div class="deck-list-information">
                        <div class="deck-stat">
                            <span class="deck-stat-value">
                                @deck.TotalCards
                            </span>
                            <span class="deck-stat-label">
                                Cards
                            </span>
                        </div>

                        <div class="deck-stat">
                            <span class="deck-stat-value">
                                @deck.UniqueCards
                            </span>
                            <span class="deck-stat-label">
                                Unique Entries
                            </span>
                        </div>

                        <div class="deck-card-status">
                            @if (deck.HasCorrectCardCount)
                            {
                                <span class="deck-count-complete">
                                    100 Cards
                                </span>
                            }
                            else
                            {
                                <span class="deck-count-incomplete">
                                    @deck.TotalCards / 100 Cards
                                </span>
                            }
                        </div>

                        <span class="deck-import-date">
                            Imported @deck.ImportedAt.ToString("MMM d, yyyy")
                        </span>
                    </div>

                    <span class="deck-card-arrow"
                          aria-hidden="true">
                        →
                    </span>

                    <a href="@($"/decks/{deck.Id}/edit")"
                       class="deck-editor-button">
                        Open in Editor
                    </a>
                    
                    <a href="@($"/deck-export?deck={deck.Id}")"
                       class="deck-export-button">
                        Export
                    </a>

                </div>
            }
        </div>
    }

</div>

@code {
    private List<Deck> decks = new();

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        string? userId =
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        decks = await DeckService.GetAllDecksAsync(userId);
    }
}
